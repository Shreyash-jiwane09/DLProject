# Copy this file to .env and fill in your values
# Environment variables used by MLflow and related tooling

# MLflow Tracking
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Optional: DVC remote configuration (if you use a remote storage)
# DVC_REMOTE_URL=
# DVC_REMOTE_TYPE= # e.g., s3, gdrive, ssh

# Optional: Flask runtime
# FLASK_ENV=production
# PORT=8080
