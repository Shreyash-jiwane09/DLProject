pipeline {
    agent any

    environment {
        PYTHON_VERSION     = '3.8'
        MLFLOW_TRACKING_URI = credentials('mlflow-tracking-uri')
        DAGSHUB_TOKEN       = credentials('dagshub-token')

        // AWS Credentials
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
        AWS_ACCOUNT_ID        = credentials('AWS_ACCOUNT_ID')
        ECR_REPOSITORY        = credentials('ECR_REPOSITORY')
        AWS_REGION = "us-east-1"

        // EC2 deployment
        EC2_USER = "ubuntu"
        EC2_HOST = "35.175.72.156"
    }

    stages {

        /* --------------------------------------------------
         *                CHECKOUT & CI STAGES
         * -------------------------------------------------- */
        stage('Checkout') {
            steps {
                echo "Checking out code..."
                checkout scm
                sh "git status"
            }
        }

        stage('Setup Python Environment') {
            steps {
                echo "Setting up Python environment..."
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }

        stage('Run Unit Tests') {
            steps {
                echo "Running unit tests..."
                sh '''
                    . venv/bin/activate
                    python -m pytest tests/ -v --junitxml=test-results.xml
                '''
            }
            post {
                always {
                    junit 'test-results.xml'
                }
            }
        }

        stage('Code Quality Check') {
            steps {
                echo "Running code quality checks..."
                sh '''
                    . venv/bin/activate
                    pip install pylint flake8
                    pylint src/cnnClassifier/ --exit-zero || true
                    flake8 src/cnnClassifier/ --exit-zero || true
                '''
            }
        }

        stage('DVC Pull Data') {
            steps {
                echo "Pulling data via DVC..."
                sh '''
                    . venv/bin/activate
                    dvc pull || echo "DVC pull failed, continuing..."
                '''
            }
        }

        stage('Train Model') {
            when { branch 'main' }
            steps {
                echo "Training ML model..."
                sh '''
                    . venv/bin/activate
                    export MLFLOW_TRACKING_URI=${MLFLOW_TRACKING_URI}
                    dvc repro
                '''
            }
        }

        stage('Model Evaluation') {
            steps {
                echo "Evaluating model..."
                sh '''
                    . venv/bin/activate
                    python evaluate.py
                '''
            }
        }

        stage('Generate Grad-CAM') {
            steps {
                echo "Generating Grad-CAM..."
                sh '''
                    . venv/bin/activate
                    python gradcam_demo.py || echo "Grad-CAM generation failed"
                '''
            }
        }

        /* --------------------------------------------------
         *                AWS ECR LOGIN
         * -------------------------------------------------- */
        stage('AWS CLI Login to ECR') {
            steps {
                echo "Authenticating with AWS ECR..."
                sh '''
                    aws configure set aws_access_key_id $AWS_ACCESS_KEY_ID
                    aws configure set aws_secret_access_key $AWS_SECRET_ACCESS_KEY
                    aws configure set default.region $AWS_REGION

                    aws ecr get-login-password --region $AWS_REGION | docker login \
                        --username AWS \
                        --password-stdin $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
                '''
            }
        }

        /* --------------------------------------------------
         *                BUILD & PUSH IMAGE
         * -------------------------------------------------- */
        stage('Build Docker Image') {
            steps {
                echo "Building Docker image..."
                sh '''
                    docker build -t $ECR_REPOSITORY:latest .
                    docker tag $ECR_REPOSITORY:latest $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPOSITORY:latest
                '''
            }
        }

        stage('Push Docker Image to ECR') {
            steps {
                echo "Pushing Docker image to AWS ECR..."
                sh '''
                    docker push $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPOSITORY:latest
                '''
            }
        }

        /* --------------------------------------------------
         *                DEPLOY TO EC2 INSTANCE
         * -------------------------------------------------- */
        stage('Deploy to EC2') {
            when { branch 'main' }
            steps {
                echo "Deploying to EC2 instance..."

                sshagent(['ssh_key']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ubuntu@35.175.72.156 "
                            cd /home/ubuntu/

                            # Download latest docker-compose
                            wget -O docker-compose.yml https://raw.githubusercontent.com/Shreyash-jiwane09/DLProject/refs/heads/main/docker-compose.yml

                            export IMAGE_NAME=$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPOSITORY:latest

                            # Login to ECR on EC2
                            aws ecr get-login-password --region $AWS_REGION | docker login \
                                --username AWS \
                                --password-stdin $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com

                            # Update docker-compose.yml with correct image
                            sed -i \"s|image:.*|image: $IMAGE_NAME|\" docker-compose.yml

                            docker compose pull
                            docker compose up -d --force-recreate
                        "
                    '''
                }
            }
        }

        /* --------------------------------------------------
         *                SAVE ARTIFACTS
         * -------------------------------------------------- */
        stage('Archive Artifacts') {
            steps {
                echo "Archiving artifacts..."
                archiveArtifacts artifacts: 'artifacts/**/*.png, artifacts/**/*.json, metrics.json',
                                 allowEmptyArchive: true
            }
        }
    }

    post {
        always {
            echo "Cleaning workspace..."
            sh '''
                docker system prune -f || true
                rm -rf venv || true
            '''
        }
        success {
            echo "Pipeline completed successfully! ✅"
        }
        failure {
            echo "Pipeline failed! ❌"
        }
    }
}
